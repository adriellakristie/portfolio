  <style>
.pv-row{
  display:flex;
  gap:10px;
  height:460px;
  max-width:1100px;
  width:100%;
  padding:1rem 24px;
  margin:0 auto;
}
.pv-pill{
  position:relative;
  flex:1 1 58px;
  border-radius:26px;
  overflow:hidden;
  cursor:pointer;
  transition:flex-grow .38s cubic-bezier(.2,.8,.2,1), flex-basis .38s cubic-bezier(.2,.8,.2,1);
  display:flex;flex-direction:column;padding:20px 0;}
  
.pv-row:hover .pv-pill{flex-grow:1;}
.pv-row .pv-pill:hover,.pv-row .pv-pill.pv-expanded{flex-grow:9;flex-basis:220px;}
.pv-num{font-size:12px;font-weight:500;text-align:center;margin-bottom:12px;}
.pv-collapsed{writing-mode:vertical-rl;transform:rotate(180deg);font-size:13px;font-weight:500;
  margin:0 auto;white-space:nowrap;transition:opacity .2s;}
.pv-pill:hover .pv-collapsed,.pv-pill.pv-expanded .pv-collapsed{opacity:0;}
.pv-expand{position:absolute;inset:0;padding:44px 16px 16px;opacity:0;transition:opacity .25s;
  display:flex;flex-direction:column;gap:8px;}
.pv-pill:hover .pv-expand,.pv-pill.pv-expanded .pv-expand{opacity:1;}
.pv-title{font-size:14px;font-weight:500;line-height:1.3;}
.pv-desc{font-size:12px;line-height:1.5;opacity:.85;}
.pv-file{font-family:var(--font-mono);font-size:11px;opacity:.7;margin-top:auto;}
</style>
<h2 class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;">Ten-step flow of how EcoBite scores and surfaces sustainable restaurants, shown as expandable pills</h2>
<div class="pv-row" id="pv-row"></div>
<script>
const steps=[
{t:"Load the neighborhood map",d:"Mapbox GL renders 10 clickable NYC neighborhood polygons across Manhattan and Brooklyn, with hover states.",f:"NeighborhoodMap.jsx · Mapbox GL 3",bg:"#B5D4F4",fg:"#042C53"},
{t:"Seed restaurant + building data",d:"DOHMH inspection records and LL84 building energy records are fetched and matched to each restaurant by address.",f:"services/nyc_open_data.py · scripts/seed.py",bg:"#9FE1CB",fg:"#04342C"},
{t:"Score energy, water, health",d:"Each restaurant is scored in parallel: energy efficiency (50pts), water efficiency (25pts), health grade (25pts).",f:"services/scoring.py",bg:"#9FE1CB",fg:"#04342C"},
{t:"Calculate the Green Score",d:"The three components sum into one 0-100 score, tiered green (≥70), yellow (50-69), red (<50).",f:"services/scoring.py · green_score()",bg:"#9FE1CB",fg:"#04342C"},
{t:"Rank top 5 per neighborhood",d:"Sidebar surfaces the greenest restaurants in each area, filterable between Restaurants and Sips & Sweets.",f:"routers/restaurants.py",bg:"#B5D4F4",fg:"#042C53"},
{t:"Search or browse",d:"Live search across thousands of restaurants, or click a map pin — both surface the score badge and neighborhood.",f:"SearchBar.jsx",bg:"#B5D4F4",fg:"#042C53"},
{t:"View the score breakdown",d:"Restaurant detail view shows the full eco-score split across energy, water, and health with progress bars.",f:"MapPage.jsx",bg:"#B5D4F4",fg:"#042C53"},
{t:"Scan a menu (optional)",d:"User uploads a photo of the menu; OpenAI Vision reads each dish and estimates its carbon footprint.",f:"menu_scanner.py",bg:"#F5C4B3",fg:"#4A1B0C"},
{t:"Bookmark & log orders",d:"Users save restaurants and log what they ordered, building a personal history of choices.",f:"UserProfile.jsx · AuthContext.jsx",bg:"#B5D4F4",fg:"#042C53"},
{t:"Grow the plant avatar",d:"Logged orders roll into a CO₂ savings total, and the gamified avatar grows through 5 visual stages as it accumulates.",f:"WateringAvatar.jsx",bg:"#F4C0D1",fg:"#4B1528"}
];
const row=document.getElementById('pv-row');
steps.forEach((s,i)=>{
  const pill=document.createElement('div');
  pill.className='pv-pill';
  pill.style.background=s.bg;
  pill.style.color=s.fg;
  pill.innerHTML=`
    <div class="pv-num">${i+1}</div>
    <div class="pv-collapsed">${s.t}</div>
    <div class="pv-expand">
      <div class="pv-title">${s.t}</div>
      <div class="pv-desc">${s.d}</div>
      <div class="pv-file">${s.f}</div>
    </div>`;
  pill.addEventListener('click',()=>{
    const already=pill.classList.contains('pv-expanded');
    row.querySelectorAll('.pv-pill').forEach(p=>p.classList.remove('pv-expanded'));
    if(!already) pill.classList.add('pv-expanded');
  });
  row.appendChild(pill);
});
</script>

  <!-- Closing imagery -->
  <section class="section closing-space">
    <div class="image-block tall" style="max-width: none; margin: 0; padding: 0;">
      <div class="placeholder"></div>
    </div>
  </section>

  <footer class="site-footer">
    © Adriella Kristie — All rights reserved
  </footer>

  <script src="../grain.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const dropdownTriggers = document.querySelectorAll('.nav-item-with-dropdown');
      dropdownTriggers.forEach(trigger => {
        const navLink = trigger.querySelector('.nav-link');
        navLink.addEventListener('click', function(e) {
          if (window.matchMedia('(hover: none)').matches) {
            e.preventDefault();
            dropdownTriggers.forEach(other => { if (other !== trigger) other.classList.remove('active'); });
            trigger.classList.toggle('active');
          }
        });
      });
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.nav-item-with-dropdown')) {
          dropdownTriggers.forEach(trigger => trigger.classList.remove('active'));
        }
      });
    });

    document.addEventListener('DOMContentLoaded', function() {
      const hamburgerBtn = document.getElementById('hamburgerBtn');
      const mobileSidebar = document.getElementById('mobileSidebar');
      const sidebarOverlay = document.getElementById('sidebarOverlay');

      function openSidebar() {
        hamburgerBtn.classList.add('active');
        mobileSidebar.classList.add('active');
        sidebarOverlay.classList.add('active');
      }
      function closeSidebar() {
        hamburgerBtn.classList.remove('active');
        mobileSidebar.classList.remove('active');
        sidebarOverlay.classList.remove('active');
      }

      hamburgerBtn.addEventListener('click', function() {
        mobileSidebar.classList.contains('active') ? closeSidebar() : openSidebar();
      });
      sidebarOverlay.addEventListener('click', closeSidebar);
      mobileSidebar.querySelectorAll('a').forEach(link => link.addEventListener('click', closeSidebar));
    });
  </script>

</body>
</html>